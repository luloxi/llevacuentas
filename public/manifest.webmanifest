{
  "name": "LlevaCuentas",
  "short_name": "LlevaCuentas",
  "description": "Importá gastos de tarjeta, tickets y balance compartido",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "es-AR",
  "icons": [
    {
      "src": "/icon",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-icon",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "comprobante",
          "accept": [
            "image/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".pdf"
          ]
        }
      ]
    }
  }
}
